  "cases": [
    {
      "id": "case:FIR-2026-0042",
      "fir_number": "FIR-2026-0042",
      "station": "Swargate Police Station, Pune",
      "incident_time": "2026-08-14T21:30:00+05:30",
      "sections": [
        "BNS 308(2)",
        "BNS 351(3)",
        "BNS 3(5)"
      ],
      "narrative": "On 14 August 2026 at about 21:30 hours the complainant Deepak More, resident of Kothrud, Pune, was returning home from Swargate, Pune when he was stopped near the bus stand by the accused Rahul Jadhav and two unknown persons. Rahul Jadhav demanded Rs. 2,00,000 as protection money on behalf of Vikram Singh of the Pashan Gang and threatened to kill the complainant if he did not pay. The accused arrived in a white Scorpio bearing registration MH 12 AB 1234. Since 1 August 2026 the complainant received six threatening calls on his mobile number 9420055667 from mobile number 9823011223, which he identified as the number of Rahul Jadhav. Offence registered under BNS 308(2), 351(3) and 3(5).",
